{
  "name": "train-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Create with: npx wrangler kv namespace create TS_KV  — then paste the id here.
  "kv_namespaces": [{ "binding": "TS_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }]
  // PLK_API_KEY is a secret: npx wrangler secret put PLK_API_KEY
  // Without it the worker serves synthetic demo departures.
}
